; Engine configuration file.
; Edited by hand and by the Godot editor. Keep keys sorted by section.

config_version=5

[application]

config/name="Dugout"
config/description="3D baseball game: manager league, career mode, full-action matches."
run/main_scene="res://match/duel.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/exclude_addons=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
