#!/usr/bin/env bash
# Developer commands for the baseball project. Run "./dev help".
#
# Linux Godot (headless tests, checks, software-rendered screenshots) runs inside WSL.
# Windows Godot (real GPU: playing, the editor, performance) is started through WSL interop
# and opens the project over its \\wsl.localhost path.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GAME="$ROOT/game"
GODOT="${GODOT:-$ROOT/.tools/godot-4.7.2/Godot_v4.7.2-stable_linux.x86_64}"
BLENDER="${BLENDER:-$ROOT/.tools/blender-5.3.0/blender}"
GODOT_WIN="${GODOT_WIN:-$ROOT/.tools/godot-4.7.2-win/Godot_v4.7.2-stable_win64.exe}"
GODOT_WIN_CONSOLE="${GODOT_WIN_CONSOLE:-$ROOT/.tools/godot-4.7.2-win/Godot_v4.7.2-stable_win64_console.exe}"
FFMPEG="${FFMPEG:-$ROOT/.tools/ffmpeg/node_modules/ffmpeg-static/ffmpeg}"

win_game_path() { wslpath -w "$GAME"; }

# A tool's window on Windows must not take the keyboard or the pointer: the person may be
# playing the game while a tool photographs something, and a window that came to the front
# took his keys and mouse from it. The engine reads override.cfg beside project.godot when it
# starts: there for a tool's start only (the game itself undoes the setting if it is ever
# started in that moment: TitleScreen), and the window is opened off the desktop.
# The caster's voice server (Supertonic M3), started once and left running, detached from this
# terminal (the game asks it for each line of the play-by-play; content-local/voice.json).
start_voice() {
  local py="$ROOT/.tools/supertonic-src/py/.venv/bin/python"
  [ -f "$ROOT/content-local/voice.json" ] && [ -x "$py" ] || return 0
  curl -s -m 1 http://127.0.0.1:8765/ping >/dev/null 2>&1 && return 0
  setsid nohup "$py" "$ROOT/tools/audio/voice_server.py" >"$ROOT/build/voice_server.log" 2>&1 < /dev/null &
  for _ in $(seq 1 30); do
    curl -s -m 1 http://127.0.0.1:8765/ping >/dev/null 2>&1 && { echo "voice: caster ready"; return 0; }
    sleep 1
  done
  echo "voice: the caster's server did not start (build/voice_server.log)"
}

quiet_window_on() {
  printf '[display]\n\nwindow/size/no_focus=true\n' > "$GAME/override.cfg"
  ( sleep 8; rm -f "$GAME/override.cfg" ) >/dev/null 2>&1 &
}

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  import)
    # Rebuild the import cache and the global class list. Needed after adding files.
    "$GODOT" --headless --path "$GAME" --import
    ;;
  check)
    # Parse every project script (addons excluded). Untyped declarations are errors.
    "$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true
    failed=0
    while IFS= read -r file; do
      res="res://${file#"$GAME"/}"
      if ! out="$("$GODOT" --headless --path "$GAME" --check-only --script "$res" 2>&1)"; then
        failed=1
        echo "FAIL $res"
        echo "$out" | grep -E "ERROR|at:" || true
      fi
    done < <(find "$GAME" -name '*.gd' -not -path '*/addons/*' -not -path '*/.godot/*' | sort)
    [ "$failed" -eq 0 ] && echo "check: all scripts parse"
    exit "$failed"
    ;;
  test)
    # Headless test run. Extra arguments go to GUT, e.g. ./dev test -gtest=res://tests/core/test_field.gd
    "$GODOT" --headless --path "$GAME" -s addons/gut/gut_cmdln.gd "$@"
    ;;
  shot)
    # ./dev shot [out.png] [res://scene.tscn]   Software-rendered capture inside WSL.
    out="$(realpath -m "${1:-$ROOT/build/shot.png}")"
    scene="${2:-res://match/duel.tscn}"
    mkdir -p "$(dirname "$out")"
    "$GODOT" --path "$GAME" --rendering-method mobile --rendering-driver vulkan --resolution 1280x720 \
      --script res://tools/screenshot.gd -- --scene "$scene" --out "$out"
    ;;
  model)
    # Rebuild the player model with Blender + MPFB and import it into the game.
    # Blender keeps its settings and the MPFB add-on under .tools/blender-user.
    # The standard build is player_base.glb; lean, solid and heavy builds beside it (S11-1).
    export BLENDER_USER_RESOURCES="$ROOT/.tools/blender-user"
    mkdir -p "$ROOT/build"
    "$BLENDER" -b --python "$ROOT/tools/blender/make_player.py" -- \
      "$GAME/assets/characters/player_base.glb" "$ROOT/build/player_preview.png" standard 2>&1 | grep -E "make_player|Error|Traceback"
    for build in lean solid heavy; do
      "$BLENDER" -b --python "$ROOT/tools/blender/make_player.py" -- \
        "$GAME/assets/characters/player_$build.glb" "$ROOT/build/player_preview_$build.png" "$build" 2>&1 | grep -E "make_player: (build|wrote)|Error|Traceback"
    done
    "$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true
    # The skin maps are read with mipmaps (no shimmer at a distance); the relief is a normal map.
    for f in "$GAME"/assets/characters/player_*_skin_detail.png.import \
        "$GAME"/assets/characters/player_*_shade.png.import "$GAME"/assets/characters/player_*_folds.png.import; do
      [ -f "$f" ] && sed -i 's|^mipmaps/generate=false|mipmaps/generate=true|' "$f"
    done
    # The relief and vein maps carry slopes in two channels and something else in the third:
    # kept as they are (not squeezed as normal maps, which would drop the third).
    for f in "$GAME"/assets/characters/player_skin_relief.png.import; do
      [ -f "$f" ] && sed -i 's|^mipmaps/generate=false|mipmaps/generate=true|; s|^compress/mode=.*|compress/mode=0|; s|^compress/normal_map=.*|compress/normal_map=2|; s|^detect_3d/compress_to=.*|detect_3d/compress_to=0|' "$f"
    done
    "$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true
    echo "model: rebuilt game/assets/characters/player_{base,lean,solid,heavy}.glb (previews: build/player_preview*.png)"
    ;;
  props)
    # Rebuild the equipment (glove, catcher's mitt, bat, ball cover) to real sizes with Blender.
    export BLENDER_USER_RESOURCES="$ROOT/.tools/blender-user"
    "$BLENDER" -b --python "$ROOT/tools/blender/make_props.py" -- "$GAME/assets/props" 2>&1 | grep -E "make_props|Error|Traceback"
    "$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true
    ;;
  mocap)
    # Recorded deliveries and swings from the Driveline OpenBiomechanics Project
    # (CC BY-NC-SA 4.0: non-commercial, and not for anyone working with a professional
    # sports organisation). The joint tables are downloaded once into content-local/raw/obp/
    # and converted into content-local/animations/, both outside git.
    #   ./dev mocap                      the default pitcher and hitter
    #   ./dev mocap list pitch|swing     the fastest trials on record
    #   ./dev mocap pitch 2916_4 fast    another trial, saved as form "fast"
    #   ./dev mocap forms                the game's 20 pitching and 20 batting forms
    raw="$ROOT/content-local/raw/obp"
    mkdir -p "$raw"
    for kind in pitching hitting; do
      if [ ! -f "$raw/$kind/landmarks.csv" ]; then
        echo "mocap: downloading the $kind joint table"
        curl -fsSL --max-time 900 -o "$raw/${kind}_landmarks.zip" \
          "https://github.com/drivelineresearch/openbiomechanics/releases/download/dataset-v1/${kind}_landmarks.zip"
        mkdir -p "$raw/$kind"
        unzip -q -o "$raw/${kind}_landmarks.zip" -d "$raw/$kind"
      fi
      for table in metadata.csv poi/poi_metrics.csv; do
        out="$raw/${kind}_$(basename "$table")"
        [ -f "$out" ] || curl -fsSL --max-time 120 -o "$out" \
          "https://raw.githubusercontent.com/drivelineresearch/openbiomechanics/main/baseball_$kind/data/$table"
      done
    done
    convert="$ROOT/tools/mocap/convert_obp.py"
    if [ "${1:-}" = "list" ]; then
      python3 "$convert" list "${2:-pitch}"
    elif [ "${1:-}" = "forms" ]; then
      # The twenty pitching and twenty batting forms (docs/13 S10), with catalogues. Each round
      # checks every clip on the player model and replaces the trials that fail.
      for round in 1 2 3 4; do
        python3 "$ROOT/tools/mocap/forms.py" | grep -v "^convert_obp"
        "$GODOT" --headless --path "$GAME" --script res://tools/motion_report.gd -- --forms --limit 45 2>&1 | grep "clips pass"
        [ -f "$ROOT/content-local/forms/failing.txt" ] || break
      done
    elif [ $# -ge 2 ]; then
      python3 "$convert" "$1" "$2" "$ROOT/content-local/animations/$1/${3:-default}.json"
    else
      # The default delivery (practice, and any pitcher without a form): a right-handed
      # three-quarter arm at 43 degrees, the most common slot. (It was 3037_2, a 22-degree
      # arm that looked like a sidearm and read as a fault: "팔각도가 이상하다".)
      python3 "$convert" pitch 3055_3 "$ROOT/content-local/animations/pitch/default.json"
      python3 "$convert" swing 48_2 "$ROOT/content-local/animations/swing/default.json"
    fi
    ;;
  materials)
    # Fetches the CC0 surface textures and skies (tools/assets/fetch_materials.sh) and imports
    # them: tiled surfaces with mipmaps (no shimmer far off), skies with their sun clamped
    # (the game has its own sun).
    "$ROOT/tools/assets/fetch_materials.sh"
    "$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true
    for f in "$GAME"/assets/materials/*.jpg.import; do
      sed -i 's|^mipmaps/generate=false|mipmaps/generate=true|' "$f"
    done
    for f in "$GAME"/assets/sky/*.hdr.import; do
      sed -i 's|^process/hdr_clamp_exposure=false|process/hdr_clamp_exposure=true|' "$f"
    done
    "$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true
    echo "materials: $(ls "$GAME"/assets/materials/*.jpg | wc -l) maps, $(ls "$GAME"/assets/sky/*.hdr | wc -l) skies imported"
    ;;
  native)
    # Builds the native ball physics (approved proposal 5, tools/native) for Linux and
    # Windows into game/native/bin (outside git). Needs the tools under .tools: godot-cpp,
    # SCons (.tools/pyenv) and zig (as the Windows cross compiler). Without the libraries
    # the game runs the same physics in GDScript.
    export GODOT_CPP="$ROOT/.tools/godot-cpp" NATIVE_OUT="$GAME/native/bin"
    API="$ROOT/.tools/extension_api_4.7.2.json"
    if [ ! -f "$API" ]; then
      (cd "$ROOT/.tools" && "$GODOT" --headless --dump-extension-api >/dev/null 2>&1 && mv extension_api.json "$API")
    fi
    cd "$ROOT/tools/native"
    "$ROOT/.tools/pyenv/bin/scons" platform=linux target=template_release custom_api_file="$API" -j8 | grep -E "Linking Shared|error|Error" || true
    PATH="$ROOT/tools/native/zig-mingw:$PATH" "$ROOT/.tools/pyenv/bin/scons" platform=windows use_mingw=yes use_llvm=yes lto=none target=template_release \
      custom_api_file="$API" -j8 | grep -E "Linking Shared|error|Error" || true
    # The extension file goes in only with the libraries (without them Godot would complain
    # at every start; the game then runs the GDScript physics).
    cp "$ROOT/tools/native/ballphysics.gdextension" "$GAME/native/ballphysics.gdextension"
    "$GODOT" --headless --path "$GAME" --import >/dev/null 2>&1 || true
    ls -la "$GAME/native/bin"
    ;;
  kbo)
    # ./dev kbo [season ...|all]   Real KBO seasons into the local content pack (docs/13 S17): the
    # Kaggle dataset "KBO Player Stats 1982-2026" (CC BY-NC-SA 4.0, needs ~/.kaggle/access_token)
    # -> content-local/raw/kbo-<season>/ tables -> content-local/rosters/kbo-<season>.json roster
    # pack and content-local/seasons/kbo-<season>.json season pack (R7), then the pack is brought
    # level with the real season (the league's rates and each club's strength: calibrate_roster).
    # No argument or "all": every season chosen in content-local/kbo/history.json (its clubs'
    # names that year, the real table and postseason, the rules and the scenarios).
    data="$ROOT/content-local/raw/kaggle-kbo-stats"
    if [ ! -f "$data/kbo_batting_stats_season_1982-2026.csv" ]; then
      mkdir -p "$data"
      "$ROOT/.tools/pyenv/bin/kaggle" datasets download netsong/kbo-player-stats-19822025 -p "$data" --unzip
    fi
    seasons="$*"
    if [ -z "$seasons" ] || [ "$seasons" = "all" ]; then
      seasons="$(python3 -I "$ROOT/tools/kbo/kaggle_to_tables.py" --list)"
    fi
    for season in $seasons; do
      python3 -I "$ROOT/tools/kbo/kaggle_to_tables.py" "$season" | tail -1
      # Each pitcher's real pitches where the local pitch tables have the season (2023 on).
      if [ -f "$ROOT/content-local/raw/kbo-pbp/kbo_pbp_$season.parquet" ]; then
        "$ROOT/.tools/pyenv/bin/python" -I "$ROOT/tools/kbo/pitch_mix.py" "$season" | tail -1
      fi
      "$GODOT" --headless --path "$GAME" --script res://tools/build_roster.gd -- --in "../content-local/raw/kbo-$season" \
        --out "../content-local/rosters/kbo-$season.json" --id "kbo-$season" --name "$season 시즌" --season "$season" 2>&1 | grep -E "build_roster|ERROR" || true
      pack="--season kbo-$season"
      [ -f "$ROOT/content-local/raw/kbo-$season/season.json" ] && pack="--pack-file ../content-local/raw/kbo-$season/season.json"
      "$GODOT" --headless --path "$GAME" --script res://tools/calibrate_roster.gd -- $pack \
        --raw "../content-local/raw/kbo-$season" 2>&1 | grep -E "calibrate: (final|clubs|wrote|no such)|ERROR" || true
    done
    # Each player's real line for the season (what the scoreboard shows).
    python3 -I "$ROOT/tools/kbo/season_records.py" | tail -3
    ;;
  audio)
    # ./dev audio [sfx,crowd,cheer,music,songs]   Makes the game's own sounds (tools/audio/make_sounds.py)
    # into game/audio/ with Blender's Python (numpy) and ffmpeg (Vorbis).
    py="$(ls "$ROOT"/.tools/blender-*/[0-9]*/python/bin/python3* | head -1)"
    ff="$ROOT/.tools/ffmpeg/node_modules/ffmpeg-static/ffmpeg"
    "$py" "$ROOT/tools/audio/make_sounds.py" "$ff" "$GAME/audio" "$@"
    ;;
  sim)
    # Simulated games with the stat resolver (headless).
    #   ./dev sim                      one game: play-by-play and box score
    #   ./dev sim --seed 3 --quiet     another game, box score only
    #   ./dev sim --games 4000         league totals against data/league_env.json targets
    #   ./dev sim --physical --games 800 --jobs 8
    #                                  pitch-by-pitch games (S5), split over 8 processes
    #   ./dev sim league               rebuild the fictional league (data/rosters/fiction-2026.json)
    #   ./dev sim season               a 144-game season in one division: leaders and team spread
    if [ "${1:-}" = "league" ]; then
      shift
      "$GODOT" --headless --path "$GAME" --script res://tools/gen_league.gd -- "$@" 2>&1 | grep -E "gen_league|ERROR|SCRIPT"
    elif [ "${1:-}" = "season" ]; then
      shift
      "$GODOT" --headless --path "$GAME" --script res://tools/sim_season.gd -- "$@" 2>&1 | grep -v "^Godot Engine" | grep -v "^$"
    elif printf '%s\n' "$@" | grep -q -- "--jobs"; then
      # Split the batch over separate processes (one per core), then add the totals up.
      #   ./dev sim --physical --games 800 --jobs 8
      jobs=1; games=1000; seed=2026; rest=(); tmp=""
      while [ $# -gt 0 ]; do
        case "$1" in
          --jobs) jobs="$2"; shift 2 ;;
          --games) games="$2"; shift 2 ;;
          --seed) seed="$2"; shift 2 ;;
          *) rest+=("$1"); shift ;;
        esac
      done
      tmp="$(mktemp -d)"
      files=()
      for j in $(seq 0 $((jobs - 1))); do
        files+=("$tmp/part$j.json")
        "$GODOT" --headless --path "$GAME" --script res://tools/sim_batch.gd -- --games $((games / jobs)) --leagues 1 \
          --seed $((seed + j * 7919)) --dump "$tmp/part$j.json" "${rest[@]}" >/dev/null 2>&1 &
      done
      wait
      "$GODOT" --headless --path "$GAME" --script res://tools/sim_batch.gd -- --merge "$(IFS=,; echo "${files[*]}")" "${rest[@]}" 2>&1 | grep -v "^Godot Engine" | grep -v "^$"
      rm -rf "$tmp"
    elif printf '%s\n' "$@" | grep -q -- "--games"; then
      "$GODOT" --headless --path "$GAME" --script res://tools/sim_batch.gd -- "$@" 2>&1 | grep -v "^Godot Engine" | grep -v "^$"
    else
      "$GODOT" --headless --path "$GAME" --script res://tools/sim_game.gd -- "$@" 2>&1 | grep -v "^Godot Engine"
    fi
    ;;
  play)
    # Run the game on Windows with the real GPU (the caster's voice server first, when the local
    # pack has one: content-local/voice.json).
    start_voice
    "$GODOT_WIN" --path "$(win_game_path)" "$@"
    ;;
  voice)
    # ./dev voice [stop]   The caster's voice server (tools/audio/voice_server.py) on its own.
    if [ "${1:-}" = stop ]; then
      pkill -f "tools/audio/[v]oice_server.py" && echo "voice: stopped" || echo "voice: not running"
    else
      start_voice
    fi
    ;;
  editor)
    # Open the project in the Godot editor on Windows.
    "$GODOT_WIN" --editor --path "$(win_game_path)" "$@" >/dev/null 2>&1 &
    echo "editor: started on Windows for $(win_game_path)"
    ;;
  perf)
    # ./dev perf [--scene res://x.tscn] [--seconds 5]   Frame-rate probe on Windows, vsync off.
    # The sound is mixed but not played aloud (SOUND=1 to hear it).
    # Off the desktop and without focus, like the other tool windows (the user may be playing).
    quiet_window_on
    "$GODOT_WIN_CONSOLE" --path "$(win_game_path)" --disable-vsync --resolution 1920x1080 --position 30000,30000 $( [ "${SOUND:-0}" = 1 ] || echo --audio-driver Dummy ) \
      --script res://tools/perf_probe.gd -- "$@"
    ;;
  video)
    # ./dev video [out.mp4] [--bat 2] [--pitch 2] [--seed n]   Records a scripted demonstration
    # on Windows (GPU): the player bats at a few pitches, then throws a few. Godot writes every
    # frame at a steady 60 a second, so the video is smooth however fast the PC renders.
    out="$ROOT/build/demo/dugout-demo.mp4"
    if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then out="$(realpath -m "$1")"; shift; fi
    mkdir -p "$(dirname "$out")"
    raw="${out%.mp4}.avi"
    "$GODOT_WIN_CONSOLE" --path "$(win_game_path)" --resolution "${RES:-1280x720}" --audio-driver Dummy \
      --write-movie "$(wslpath -w "$raw")" --script res://tools/demo_reel.gd -- "$@" 2>&1 | grep -E "demo_reel|ERROR|SCRIPT" || true
    "$FFMPEG" -y -loglevel error -i "$raw" -an -c:v libx264 -preset slow -crf 21 -pix_fmt yuv420p -movflags +faststart "$out"
    rm -f "$raw"
    echo "video: $out ($(du -h "$out" | cut -f1))"
    ;;
  tool-win)
    # ./dev tool-win <tool> <out prefix> [args...]   Runs a script from game/tools on Windows
    # with the GPU. The output prefix is relative to the project folder, for example:
    #   ./dev tool-win motion_shots build/motion/pitch --who pitch --view side
    #   ./dev tool-win duel_shots build/duel/bat --mode bat --pitches 2
    tool="$1"; out="$2"; shift 2
    mkdir -p "$(dirname "$ROOT/$out")"
    # Tools are quiet (they run while nobody listens): the sound is mixed but not played.
    quiet_window_on
    "$GODOT_WIN_CONSOLE" --path "$(win_game_path)" --resolution "${RES:-1280x720}" --position 30000,30000 --audio-driver Dummy \
      --script "res://tools/$tool.gd" -- --out "$(wslpath -w "$ROOT/$(dirname "$out")")\\$(basename "$out")" "$@" 2>&1 \
      | grep -E "^[a-z_]+:|ERROR|SCRIPT|^   at: |GDScript backtrace|^ +\[[0-9]+\]" || true
    ;;
  shot-win)
    # ./dev shot-win [out.png] [res://scene.tscn]   GPU-rendered capture on Windows.
    out="$(realpath -m "${1:-$ROOT/build/shot-win.png}")"
    scene="${2:-res://match/duel.tscn}"
    mkdir -p "$(dirname "$out")"
    "$GODOT_WIN_CONSOLE" --path "$(win_game_path)" --resolution 1920x1080 --audio-driver Dummy \
      --script res://tools/screenshot.gd -- --scene "$scene" --out "$(wslpath -w "$out")"
    ;;
  help|*)
    cat <<'EOF'
Usage: ./dev <command>

  import      rebuild Godot's import cache and class list
  check       parse every script; fails on errors and untyped declarations
  test        run the headless test suite (GUT)
  shot        save a software-rendered screenshot inside WSL   [out.png] [scene]
  model       rebuild the player model (Blender + MPFB) and import it
  props       rebuild the glove, mitt, bat and ball cover to real sizes (Blender)
  sim         simulate games (stat resolver)                    [--games n] [--seed n] | league
  materials   fetch and import the CC0 surface textures and skies
  native      build the native ball physics (Linux, Windows)
  mocap       fetch and convert recorded deliveries and swings   [list pitch|swing] | [pitch|swing <trial> [form]]
  play        run the game on Windows (GPU)
  editor      open the Godot editor on Windows
  perf        measure frame rate on Windows                    [--scene ..] [--seconds ..]
  shot-win    save a GPU-rendered screenshot on Windows        [out.png] [scene]
  video       record a scripted batting and pitching demo      [out.mp4] [--bat n] [--pitch n]
  tool-win    run a script from game/tools on Windows (GPU)    <tool> <out prefix> [args]
EOF
    ;;
esac
